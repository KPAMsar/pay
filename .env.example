# Server Configuration
PORT=9000
PORT_NO=9000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=sojipay_db

# JWT Authentication
TOKEN_SECRET=your_secure_jwt_secret_key_here
TOKEN_EXPIRES_IN=7d

# Email Configuration
# Options: sendgrid, mailgun, aws
EMAIL_PROVIDER=sendgrid
MAIL_FROM=noreply@sojipay.com

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key

# Mailgun (if EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=your_mailgun_api_key

# AWS SES (if EMAIL_PROVIDER=aws)
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key

# Termii SMS Service
TERMII_API_KEY=your_termii_api_key
TERMII_BASE_URL=https://api.ng.termii.com/api

# VTPass (Utility Payments Provider)
VTPASS_URL=https://api-service.vtpass.com/api
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_PUBLIC_KEY=your_vtpass_public_key
VTPASS_SECRET_KEY=your_vtpass_secret_key

# Bridgecard (Virtual Card Provider)
BRIDGECARD_BASE_URL=https://issuecards.api.bridgecard.co
BRIDGECARD_BASE_URL_ALT=https://issuecards.api.bridgecard.co
BRIDGECARD_AUTH_TOKEN=your_bridgecard_auth_token

# SafeHaven (Payment Gateway)
SAFE_HAVEN_OAUTH_CLIENT_ID=your_safehaven_client_id
SAFE_HAVEN_CLIENT_ASSERTION=your_safehaven_client_assertion
SAFE_HAVEN_CALLBACK=https://yourdomain.com/api/v1/safehaven/callback
SAFE_HAVEN_DEBIT_ACCOUNT=your_safehaven_debit_account_number
SAFE_HAVEN_BASEURL=https://api.safehavenmfb.com
