    "bignumber.js": "^9.1.2",
    "cloudinary": "^2.2.0",
    "dotenv": "^16.3.1",
    "express-ts-annotations": "^1.0.3",
    "generate-unique-id": "^2.0.3",
    "joi": "^17.12.0",
    "joi-objectid": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^10.2.1",
    "module-alias": "^2.2.3",
