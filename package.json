{
  "name": "sojipay",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "_moduleAliases": {
    "@root": "./build",
    "@sojipay": "./build"
  },
  "scripts": {
    "build": "rimraf build && npx tsc",
    "prestart": "npm run build",
    "start": "node build/app.js",
    "serve": "concurrently \"npx tsc -w\" \"nodemon build/app.js\"",
    "migration:create": "sequelize-cli migration:create --name ",
    "migrate": "env-cmd sequelize-cli db:migrate",
    "migrate:rollback": "env-cmd sequelize-cli db:migrate:undo",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Sojipay",
  "license": "ISC",
